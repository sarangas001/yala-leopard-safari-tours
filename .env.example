# Gmail SMTP — booking requests and contact enquiries are emailed to
# NOTIFICATION_EMAIL. GMAIL_USER is the account that sends them and
# GMAIL_APP_PASSWORD is its 16-character Google App Password (NOT the normal
# Gmail password). Use a different address for NOTIFICATION_EMAIL than
# GMAIL_USER so the email reliably lands in the Inbox.
GMAIL_USER=sender@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
NOTIFICATION_EMAIL=yalaleopardsafariride@gmail.com

# Elfsight Google Reviews widget ID (the UUID after "elfsight-app-" in the embed code)
NEXT_PUBLIC_ELFSIGHT_GOOGLE_REVIEWS_ID=8a2d6268-d418-434d-bce3-940ed4ec81c6
